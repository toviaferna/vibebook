    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2.12.4",
    "clsx": "^2.1.1",
    "epubjs": "^0.3.93",
    "lucide-react": "^1.70.0",
